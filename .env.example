MONGO_URL=mongodb://localhost:27017/
DB_NAME=internship
COLLECTION_NAME=candidates
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY_HERE
CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Active LLM Provider
LLM_PROVIDER=groq

# ── LLM Model Configuration ──
GROQ_MODEL=qwen-2.5-32b
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
CEREBRAS_MODEL=gpt-oss-120b
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# ── JSON calls (query parsing, role matching, title generation) ──
JSON_TEMPERATURE=0.1
JSON_MAX_TOKENS=500

# ── Text calls (chatbot conversational reply) ──
TEXT_TEMPERATURE=0.6
TEXT_MAX_TOKENS=500

# ── Azure OpenAI Configuration ──
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY_HERE
AZURE_OPENAI_ENDPOINT=YOUR_AZURE_OPENAI_ENDPOINT_HERE
AZURE_OPENAI_DEPLOYMENT_NAME=YOUR_AZURE_OPENAI_DEPLOYMENT_NAME_HERE
AZURE_OPENAI_API_VERSION=YOUR_AZURE_OPENAI_API_VERSION_HERE
